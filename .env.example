# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
APOLLO_API_KEY=your-apollo-master-api-key

# --- Slack (only for the Slack bot) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional comma-separated allow-list of Slack user IDs (e.g. U012ABC,U034DEF)
ALLOWED_SLACK_USER_IDS=

# --- Mobile phone reveal (optional) ---
# Apollo sends mobile numbers asynchronously to a public webhook. Point this at
# wherever the Slack bot is hosted (port $PORT), include the secret as ?token=.
# Leave empty to disable mobile reveal (saves credits).
APOLLO_WEBHOOK_URL=
APOLLO_WEBHOOK_SECRET=
PORT=3000
# Personal emails are off by default (GDPR/CCPA); set true to request them.
APOLLO_REVEAL_PERSONAL_EMAILS=false

# --- Tuning (optional) ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MAX_ENRICH_PER_REQUEST=10
